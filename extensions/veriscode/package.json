{
  "name": "veriscode",
  "displayName": "Veriscode",
  "description": "SystemVerilog syntax highlighting and Verible linting/formatting, plus project scaffolding and an interactive, cycle-by-cycle simulator (Icarus Verilog under the hood) with a live timing diagram.",
  "version": "0.1.0",
  "publisher": "veriscode",
  "license": "MIT",
  "private": true,
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Programming Languages", "Linters", "Formatters", "Visualization", "Education"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "systemverilog",
        "aliases": ["SystemVerilog", "systemverilog"],
        "extensions": [".sv", ".svh"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sv-light.svg",
          "dark": "./icons/sv-dark.svg"
        }
      },
      {
        "id": "verilog",
        "aliases": ["Verilog", "verilog"],
        "extensions": [".v", ".vh"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      },
      {
        "language": "verilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "veriscode.newProject",
        "title": "New SystemVerilog Project",
        "shortTitle": "SystemVerilog Project",
        "category": "Veriscode"
      },
      {
        "command": "veriscode.simulate",
        "title": "Simulate",
        "category": "Veriscode",
        "icon": "$(play)"
      },
      {
        "command": "veriscode.composeTop",
        "title": "Build Top Module (GUI)",
        "shortTitle": "Build Top Module",
        "category": "Veriscode"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veriscode",
          "title": "Veriscode",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "veriscode": [
        {
          "type": "webview",
          "id": "veriscode.home",
          "name": "Veriscode"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "veriscode.simulate",
          "when": "resourceLangId == systemverilog || resourceLangId == verilog",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        { "command": "veriscode.newProject" },
        { "command": "veriscode.composeTop" },
        {
          "command": "veriscode.simulate",
          "when": "resourceLangId == systemverilog || resourceLangId == verilog"
        }
      ],
      "file/newFile": [
        {
          "command": "veriscode.newProject",
          "group": "file"
        }
      ],
      "explorer/context": [
        {
          "command": "veriscode.composeTop",
          "when": "explorerResourceIsFolder",
          "group": "veriscode"
        }
      ]
    },
    "configuration": [
      {
        "title": "Veriscode: Verible",
        "properties": {
          "veriscode.verible.lintOnSave": {
            "type": "boolean",
            "default": true,
            "description": "Lint a SystemVerilog file with Verible whenever it is saved."
          },
          "veriscode.verible.lintOnType": {
            "type": "boolean",
            "default": true,
            "description": "Lint with Verible as you type (after a short pause)."
          },
          "veriscode.verible.formatOnSave": {
            "type": "boolean",
            "default": false,
            "description": "Format a SystemVerilog file with Verible whenever it is saved. A file with a syntax error is left untouched."
          },
          "veriscode.verible.path": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to a `verible-verilog-lint` binary to use instead of the bundled one. The formatter (`verible-verilog-format`) is taken from the same folder. Leave blank to use the bundled copy."
          },
          "veriscode.verible.disabledRules": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["module-filename", "parameter-name-style"],
            "markdownDescription": "Verible lint rules to turn off, e.g. `line-length`. Two are off by default because the bundled workshop would trip them: `module-filename` (its files are numbered, like `01_half_adder.sv`) and `parameter-name-style` (it names constants in `ALL_CAPS`, like `OP_ADD`). Set this to `[]` to turn every rule back on."
          }
        }
      },
      {
        "title": "Veriscode: Simulator",
        "properties": {
          "veriscode.simulator.icarusPath": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to an `iverilog` binary to use instead of the bundled one. Leave blank to use the bundled copy."
          },
          "veriscode.simulator.vvpPath": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to a `vvp` binary to use instead of the bundled one. Leave blank to use the bundled copy."
          },
          "veriscode.simulator.defaultCycles": {
            "type": "integer",
            "default": 8,
            "minimum": 1,
            "description": "Number of clock cycles (or steps, for combinational designs) shown when a simulation first opens."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "node test/run.js",
    "package": "npx @vscode/vsce package --no-dependencies -o ../../dist/"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
